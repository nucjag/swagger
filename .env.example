# OpenAPI MCP Server Configuration

# URL to OpenAPI specification (required)
# Example: http://localhost:8087/openapi.json
OPENAPI_SPEC_URL=http://localhost:8087/openapi.json

# MCP Server port (default: 9999)
# MCP_PORT=9999

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
