# OpenAPI MCP Server Configuration

# URL to OpenAPI specification 
# this is failover link, main link should be in the project root .env
# Example: http://localhost:8087/openapi.json
OPENAPI_SPEC_URL=http://localhost:8087/openapi.json

# MCP Server port (default: 9999)
# MCP_PORT=9999

# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# MCP debug request configuration for TAKT
# OPENAPI_SPEC_URL=http://localhost:8000/openapi.json
# API_URL=http://takt_api:8000/api/v1
# AUTH_LOGIN_PATH=/api/v1/auth/login-default
# AUTH_LOGIN_METHOD=POST
# AUTH_LOGIN_BODY_MODE=single_field
# AUTH_LOGIN_IDENTIFIER_FIELD=user_identifier
# AUTH_TOKEN_PATH=access_token
# AUTH_HEADER_NAME=Authorization
# AUTH_HEADER_PREFIX=Bearer

# Auth debug request configuration (v1.2)
# API_BASE_URL=http://localhost:8087
# AUTH_LOGIN_PATH=/auth/login
# AUTH_LOGIN_METHOD=POST
# AUTH_LOGIN_BODY_MODE=json
# AUTH_USERNAME_FIELD=username
# AUTH_PASSWORD_FIELD=password
# AUTH_TOKEN_PATH=access_token
# AUTH_HEADER_NAME=Authorization
# AUTH_HEADER_PREFIX=Bearer
# AUTH_DEFAULT_USER=tutor
# AUTH_ROLE_MAP_JSON={"tutor":"tutor_user"}
# AUTH_CREDENTIALS_JSON={"tutor_user":{"username":"tutor@example.com","password":"secret"}}
